{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Battery Warranty Hub",
        "supportEmail": "ayushmestorage@gmail.com",
        "authorizedRedirectUris": [
          "https://battery-warranty-hub-26.firebaseapp.com/__/auth/handler",
          "https://battery-warranty-hub-26.web.app/__/auth/handler",
          "http://localhost:5000/__/auth/handler"
        ]
      }
    }
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "cleanUrls": true
  }
}
