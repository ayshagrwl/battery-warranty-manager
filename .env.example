# Google Sheets & Google Drive Configuration for Production
# -------------------------------------------------------------

# 1. Google Spreadsheet ID (from URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SPREADSHEET_ID=

# 2. Path to Google Service Account Credentials JSON file (downloaded from Google Cloud Console)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# 3. Optional: Google Drive Root Folder ID for document attachments (Claims, Challans)
GOOGLE_DRIVE_FOLDER_ID=

# 4. Apps Script Project ID (for clasp push)
APPS_SCRIPT_ID=
